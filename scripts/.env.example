# ===== AI Exchange 任务市场 API 环境变量（复制为 .env 后填写）=====

# DeepSeek 主密钥（只存服务端，绝不进前端/镜像/仓库）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 管理员令牌（签发企业 API Key 时需要，用 openssl rand -hex 32 生成）
TASK_MARKET_ADMIN_TOKEN=change-me-to-random

# Redis 地址（多实例共享限流；留空则内存回退，单机够用）
REDIS_URL=redis://redis:6379/0

# SQLite 数据库路径（生产建议迁 PostgreSQL）
TASK_MARKET_DB=/app/data/task_market.db
